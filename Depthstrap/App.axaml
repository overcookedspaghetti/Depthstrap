<Application
    x:Class="Depthstrap.App"
    Name="Depthstrap"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:sty="using:FluentAvalonia.Styling"
    xmlns:converters="using:Depthstrap.UI.Converters"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    RequestedThemeVariant="Dark"
>
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem
                Header="About Depthstrap"
                Click="About_OnClick"
            />

            <NativeMenuItemSeparator />

            <NativeMenuItem
                Header="Settings"
                Click="Settings_OnClick"
                Gesture="Meta+,"
            />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />

        <StyleInclude Source="avares://Depthstrap/UI/Elements/Controls/Hyperlink.axaml" />
        <StyleInclude Source="avares://Depthstrap/UI/Elements/Controls/OptionControl.axaml" />
        <StyleInclude Source="avares://Depthstrap/UI/Elements/Controls/SquareCard.axaml" />
        <StyleInclude Source="avares://Depthstrap/UI/Elements/Controls/Card.axaml" />
        <StyleInclude Source="avares://Depthstrap/UI/Elements/Controls/CardExpander.axaml" />
        <StyleInclude Source="avares://Depthstrap/UI/Elements/Controls/TitleBar.axaml" />
        <StyleInclude Source="avares://Depthstrap/UI/Elements/Controls/CardAction.axaml" />
        <StyleInclude Source="avares://Depthstrap/UI/Elements/Controls/IconButton.axaml" />

        <StyleInclude Source="avares://Depthstrap/UI/AppThemes/Default.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ControlTheme
                x:Key="SettingsWindowDecorationsTheme"
                TargetType="WindowDrawnDecorations"
                BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
                <Style Selector="^ /template/ TextBlock#TitleTextBlock">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </ControlTheme>

            <StaticResource x:Key="ToolTipBackground" ResourceKey="ToolTipBackgroundBrush" />
            <StaticResource x:Key="ToolTipForeground" ResourceKey="ToolTipForegroundBrush" />

            <FontFamily x:Key="Rubik">avares://Depthstrap/Resources/Fonts/Rubik-VariableFont_wght.ttf</FontFamily>
            <FontFamily x:Key="BuilderIconsRegular">avares://Depthstrap/Resources/Fonts#BuilderIcons-Regular</FontFamily>
            <FontFamily x:Key="BuilderIconsFilled">avares://Depthstrap/Resources/Fonts#BuilderIcons-Filled</FontFamily>

            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:EnumNameConverter x:Key="EnumNameConverter" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <converters:NumberAbbreviationConverter x:Key="NumberAbbreviationConverter" />
            <converters:UrlToBitmapConverter x:Key="UrlToBitmapConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
